APP_ENV=local
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
ENABLE_MOTION=true
ENABLE_FADES=true
# Render quality: fast | balanced | best.
#   fast     = old speed, lowest quality (about 1.8 Mbit/s)
#   balanced = smooth motion, sharpening, ~4 Mbit/s. About 3x slower. (default)
#   best     = same look, higher bitrate, slowest
VIDEO_QUALITY=balanced
# Crossfade between scenes instead of hard cuts. Audio stays in sync.
ENABLE_TRANSITIONS=true
TRANSITION_SECONDS=0.45
# Sharpen + vignette pass that rescues soft free-provider images.
ENABLE_IMAGE_POLISH=true
AUDIO_BITRATE=192k
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
ENABLE_BACKGROUND_MUSIC=true
BACKGROUND_MUSIC_VOLUME=0.08
# Duck the music under the narrator's voice so speech stays clear.
ENABLE_MUSIC_DUCKING=true
# Word-by-word (karaoke) captions that light up as each word is spoken.
# Falls back to a plain caption automatically if timings aren't available.
ENABLE_KARAOKE_CAPTIONS=true
WHISPER_MODEL_SIZE=base
ENABLE_WHISPER=false
# Burn the narration into the picture. YouTube/Facebook also show their own
# automatic captions when the viewer has CC on, which makes the text look
# doubled. Set false to keep only the platform's caption track.
ENABLE_BURNED_CAPTIONS=true
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
IMAGE_PROVIDER=none
AUTO_GENERATE_MISSING_IMAGES=false
AUTO_REPLACE_GENERATED_WITH_AI=true
AUTO_REPLACE_LOW_QUALITY_IMAGES=true
LOW_QUALITY_IMAGE_BYTES=200000
ENABLE_POLLINATIONS_IMAGES=true
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_DAILY_LIMIT=25
# Thumbnails: every video gets its own 16:9 thumbnail about its topic, with the
# title burned on top (composed with ffmpeg - no extra image library needed).
# THUMBNAIL_PROVIDER: auto = free Pexels stock first for real-world channels and
# generated art first for the cartoon kids channel, each falling back to the
# next. Force one with pexels / openai / pollinations, or use scene for the old
# behavior (reuse the first scene image, no extra API call).
ENABLE_AI_THUMBNAILS=true
THUMBNAIL_PROVIDER=auto
# Free stock photos, 200/hour and 20k/month at no cost: https://www.pexels.com/api/
# Also used for scene images on the real-world channels (crime/trending/...).
PEXELS_API_KEY=

# Cloudflare Workers AI: free AI image generation, no credit card. This is the
# free generator that keeps the cartoon kids channel running when OpenAI
# billing is capped and Pollinations is rate-limiting. Both values are free at
# dash.cloudflare.com (see FREE_IMAGE_SETUP.md).
# Check it with: python -m src.cli test-images --channel kids
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# ComfyUI on your own PC: unlimited free images, no credits and no API bill.
# Start ComfyUI, put a FLUX.1-schnell (Apache-2.0) or SDXL checkpoint in
# ComfyUI/models/checkpoints/, then set this to true. Needs a real GPU:
# on integrated graphics one image takes many minutes.
ENABLE_COMFYUI_THUMBNAILS=false
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=flux1-schnell-fp8.safetensors
COMFYUI_STEPS=4
COMFYUI_TIMEOUT=600

OPENAI_THUMBNAIL_MODEL=gpt-image-2
OPENAI_THUMBNAIL_QUALITY=high
THUMBNAIL_DAILY_LIMIT=40
GOOGLE_IMAGE_API_KEY=
GOOGLE_IMAGE_CX=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Second free Gemini model used when the primary model's daily quota is full
# (each free-tier model has its own daily limit). Blank = skip.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
# Free script fallbacks (used before paid OpenAI). Groq is free + fast (get a
# free key at console.groq.com). Pollinations text needs NO key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_POLLINATIONS_TEXT=true
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=private

# Spread uploads out instead of publishing a whole batch at once.
# Each video uploads private with a scheduled publishAt: the first ~1h from
# now, then one every 3h. Set YOUTUBE_SCHEDULE_UPLOADS=false to publish
# immediately (old behavior).
YOUTUBE_SCHEDULE_UPLOADS=true
YOUTUBE_SCHEDULE_INTERVAL_HOURS=3
YOUTUBE_SCHEDULE_FIRST_DELAY_HOURS=1
# Optional: fixed local publish hours for buffered videos, e.g. "10,13,16,19,21".
# When set, `python -m src.cli buffer --count 30` schedules many videos across
# the coming days at these kid-friendly times, so YouTube keeps publishing even
# while the PC is off. Leave empty to use the simple interval spacing above.
YOUTUBE_SCHEDULE_DAILY_SLOTS=
# Safety cap: max NEW uploads per day (auto queue + retry). YouTube's free daily
# API quota allows ~6 uploads; extra videos wait in the dashboard and upload
# after the quota resets (midnight Pacific). 0 = no cap. A manual "upload now"
# is not limited by this.
YOUTUBE_UPLOAD_DAILY_LIMIT=4
# Optional per-channel overrides (CHANNEL_ID in uppercase)
YOUTUBE_UPLOAD_DAILY_LIMIT_KIDS=4
YOUTUBE_UPLOAD_DAILY_LIMIT_CRIME=4
YOUTUBE_UPLOAD_DAILY_LIMIT_LOVE=4
YOUTUBE_UPLOAD_DAILY_LIMIT_HORROR=4
YOUTUBE_UPLOAD_DAILY_LIMIT_MOTIVATION=4
YOUTUBE_UPLOAD_DAILY_LIMIT_TRENDING=4
# One channel can publish to several YouTube channels ("accounts" — see
# MULTIPLE_YOUTUBE_CHANNELS.md). Each account gets its own budget; override a
# single one with YOUTUBE_UPLOAD_DAILY_LIMIT_<CHANNEL>_<ACCOUNT>:
# YOUTUBE_UPLOAD_DAILY_LIMIT_KIDS_CH2=3
#
# The daily quota belongs to the Google Cloud PROJECT, not to the YouTube
# channel: ~6 uploads/day per project. Keep the limits of everything sharing one
# client_secret at or under that, or uploads fail with HTTP 429. Check with:
#   python -m src.cli quota-status

# World Trending channel: which countries' Google Trends to read (comma-separated
# geo codes). World news headlines (Google News, BBC, Al Jazeera) are always
# added on top, so this only widens the search-trend coverage.
TRENDING_GEOS=US,GB,IN,PK,AE

# Optional job notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional free Pollinations image key: https://enter.pollinations.ai
POLLINATIONS_API_KEY=

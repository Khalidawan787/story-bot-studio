APP_ENV=local
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
ENABLE_MOTION=true
ENABLE_FADES=true
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
ENABLE_BACKGROUND_MUSIC=true
BACKGROUND_MUSIC_VOLUME=0.08
# Duck the music under the narrator's voice so speech stays clear.
ENABLE_MUSIC_DUCKING=true
# Word-by-word (karaoke) captions that light up as each word is spoken.
# Falls back to a plain caption automatically if timings aren't available.
ENABLE_KARAOKE_CAPTIONS=true
WHISPER_MODEL_SIZE=base
ENABLE_WHISPER=false
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
IMAGE_PROVIDER=none
AUTO_GENERATE_MISSING_IMAGES=false
AUTO_REPLACE_GENERATED_WITH_AI=true
AUTO_REPLACE_LOW_QUALITY_IMAGES=true
LOW_QUALITY_IMAGE_BYTES=200000
ENABLE_POLLINATIONS_IMAGES=true
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
GOOGLE_IMAGE_API_KEY=
GOOGLE_IMAGE_CX=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY_STATUS=private

# Spread uploads out instead of publishing a whole batch at once.
# Each video uploads private with a scheduled publishAt: the first ~1h from
# now, then one every 3h. Set YOUTUBE_SCHEDULE_UPLOADS=false to publish
# immediately (old behavior).
YOUTUBE_SCHEDULE_UPLOADS=true
YOUTUBE_SCHEDULE_INTERVAL_HOURS=3
YOUTUBE_SCHEDULE_FIRST_DELAY_HOURS=1
# Optional: fixed local publish hours for buffered videos, e.g. "10,13,16,19,21".
# When set, `python -m src.cli buffer --count 30` schedules many videos across
# the coming days at these kid-friendly times, so YouTube keeps publishing even
# while the PC is off. Leave empty to use the simple interval spacing above.
YOUTUBE_SCHEDULE_DAILY_SLOTS=
